@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration successful";
}

<section class="identity-page">
    <div class="identity-card identity-confirmation-card">
        <div class="identity-card-header">
            <span class="page-kicker">Account created</span>
            <h1>Registration successful</h1>
            <p>
                Your account has been created. This project uses ASP.NET Core Identity for authentication. In a production system, a confirmation link would be sent by email. For this local demonstration, please use the confirmation link below.
            </p>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-3">
            @if (Model.DisplayConfirmAccountLink)
            {
                <a id="confirm-link" class="btn btn-primary btn-lg" href="@Model.EmailConfirmationUrl">Confirm my account</a>
            }
            <a class="btn btn-outline-primary btn-lg" asp-page="./Login">Back to login</a>
        </div>
    </div>
</section>
