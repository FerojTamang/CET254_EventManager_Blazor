@model ParticipantViewModel
@{
    ViewData["Title"] = "Delete Participant";
    var registrationCount = ViewBag.RegistrationCount as int? ?? 0;
}

<section class="page-banner">
    <p class="page-kicker">Admin management</p>
    <h1 class="mb-2">Delete Participant</h1>
    <p class="page-subtitle mb-0">Review this participant before deletion. Identity user accounts are not deleted here.</p>
</section>

@if (registrationCount > 0)
{
    <div class="alert alert-warning">This participant has @registrationCount event registration(s). Deletion will be blocked.</div>
}
else
{
    <div class="alert alert-danger">Are you sure you want to delete this participant profile?</div>
}

<div class="card">
    <div class="card-body p-4">
        <h2 class="h4">@Model.FullName</h2>
        <dl class="row detail-list">
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.PhoneNumber</dd>
            <dt class="col-sm-3">Identity User</dt><dd class="col-sm-9">@(Model.ApplicationUserId ?? "Not linked")</dd>
            <dt class="col-sm-3">Registrations</dt><dd class="col-sm-9">@registrationCount</dd>
        </dl>
    </div>
    <div class="card-footer p-4">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </form>
    </div>
</div>
