@model IEnumerable<Participant>
@{
    ViewData["Title"] = "Manage Participants";
}

<section class="page-hero">
    <div>
        <p class="page-kicker">Admin management</p>
        <h1 class="mb-2">Participants</h1>
        <p class="page-subtitle mb-0">Create, edit, and review participant profiles linked to event registrations.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Participant</a>
</section>

<div class="card admin-table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead>
            <tbody>
            @foreach (var participant in Model)
            {
                <tr>
                    <td class="fw-semibold">@participant.FullName</td>
                    <td>@participant.Email</td>
                    <td>@participant.PhoneNumber</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                        <a asp-action="Details" asp-route-id="@participant.Id" class="btn btn-sm btn-primary">Details</a>
                        <a asp-action="Edit" asp-route-id="@participant.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@participant.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
