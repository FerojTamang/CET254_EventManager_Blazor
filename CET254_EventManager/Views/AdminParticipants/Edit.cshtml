@model ParticipantViewModel
@{
    ViewData["Title"] = "Edit Participant";
}

<section class="page-banner">
    <p class="page-kicker">Admin management</p>
    <h1 class="mb-2">Edit Participant</h1>
    <p class="page-subtitle mb-0">Update participant contact details while preserving any Identity link.</p>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-card">
    <div class="card-body p-4">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ApplicationUserId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-0">
            <label asp-for="ApplicationUserId" class="form-label"></label>
            <input value="@(Model.ApplicationUserId ?? "Not linked")" class="form-control" disabled />
            <div class="form-text">Identity user accounts are not managed from participant pages.</div>
        </div>
    </div>
    <div class="card-footer p-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-primary">Back</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
