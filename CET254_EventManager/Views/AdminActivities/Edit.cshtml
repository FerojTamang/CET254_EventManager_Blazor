@model ActivityViewModel
@{
    ViewData["Title"] = "Edit Activity";
}

<section class="page-banner">
    <p class="page-kicker">Admin management</p>
    <h1 class="mb-2">Edit Activity</h1>
    <p class="page-subtitle mb-0">Update activity details used across events.</p>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-card">
    <div class="card-body p-4">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select"></select><span asp-validation-for="ActivityType" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    </div>
    <div class="card-footer p-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-primary">Back</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
