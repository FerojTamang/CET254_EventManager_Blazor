@model VenueViewModel
@{
    ViewData["Title"] = "Delete Venue";
}

<section class="page-banner">
    <p class="page-kicker">Admin management</p>
    <h1 class="mb-2">Delete Venue</h1>
    <p class="page-subtitle mb-0">Review this venue before deletion.</p>
</section>

<div class="alert alert-danger">Are you sure you want to delete this venue?</div>
<div class="card">
    <div class="card-body p-4">
        <h1 class="h4">@Model.Name</h1>
        <p>@Model.Address</p>
        <span class="badge badge-blue">Capacity @Model.Capacity</span>
    </div>
    <div class="card-footer p-4">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </form>
    </div>
</div>
