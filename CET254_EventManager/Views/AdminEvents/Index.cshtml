@model IEnumerable<Event>
@{
    ViewData["Title"] = "Manage Events";
}

<section class="page-hero">
    <div>
        <p class="page-kicker">Admin management</p>
        <h1 class="mb-2">Events</h1>
        <p class="page-subtitle mb-0">Create, review, and maintain the community programme.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</section>

<div class="card admin-table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Title</th><th>Date</th><th>Time</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Title</td>
                    <td><span class="badge badge-blue">@item.EventDate.ToString("d")</span></td>
                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
