@model EventDetailsViewModel
@{
    ViewData["Title"] = "Delete Event";
}

<section class="page-banner">
    <p class="page-kicker">Admin management</p>
    <h1 class="mb-2">Delete Event</h1>
    <p class="page-subtitle mb-0">Review the event before permanently deleting it.</p>
</section>

<div class="alert alert-danger">Are you sure you want to delete this event?</div>
<div class="card">
    <div class="card-body p-4">
        <h1 class="h4">@Model.Title</h1>
        <p>@Model.EventDate.ToString("D")</p>
        <p>@Model.Description</p>
    </div>
    <div class="card-footer p-4">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </form>
    </div>
</div>
