@model EventDetailsViewModel
@{
    ViewData["Title"] = "Event Details";
    var isFull = Model.CapacityRemaining.HasValue && Model.CapacityRemaining <= 0;
    var statusText = !Model.IsRegistrationOpen ? "Registration Closed" : isFull ? "Full" : "Registration Open";
    var statusClass = !Model.IsRegistrationOpen || isFull ? "badge-gray" : "badge-green";
}

<section class="page-hero event-detail-hero">
    <div class="d-flex gap-3 align-items-start">
        <div class="date-pill date-pill-lg">
            <span>@Model.EventDate.ToString("MMM")</span>
            <strong>@Model.EventDate.Day</strong>
        </div>
        <div>
            <p class="page-kicker">Event details</p>
            <h1 class="mb-2">@Model.Title</h1>
            <p class="page-subtitle mb-0">@Model.EventDate.ToString("D") | @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
        </div>
    </div>
    <span class="status-badge @statusClass">@statusText</span>
</section>

<div class="row g-4">
    <div class="col-lg-8">
        <article class="card event-details-card h-100">
            <div class="event-visual event-visual-blue event-detail-visual"></div>
            <div class="card-body p-4 p-lg-5">
                <h2 class="h4 mb-3">About this event</h2>
                <p class="lead text-muted mb-4">@Model.Description</p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="detail-mini-card">
                            <div class="text-muted small">Date</div>
                            <strong>@Model.EventDate.ToString("D")</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-mini-card">
                            <div class="text-muted small">Time</div>
                            <strong>@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h2 class="h5 mb-3">Venues</h2>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var venue in Model.VenueNames)
                        {
                            <span class="venue-chip">@venue</span>
                        }
                    </div>
                </div>

                <div>
                    <h2 class="h5 mb-3">Activities</h2>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var activity in Model.ActivityNames)
                        {
                            <span class="activity-badge badge-purple">@activity</span>
                        }
                    </div>
                </div>
            </div>
        </article>
    </div>

    <div class="col-lg-4">
        <aside class="card action-panel sticky-lg-top">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Registration</h2>
                <div class="registration-meter mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Confirmed</span>
                        <strong>@Model.ConfirmedRegistrationCount</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Capacity remaining</span>
                        <strong>@(Model.CapacityRemaining?.ToString() ?? "Not limited")</strong>
                    </div>
                </div>

                @if (Model.IsRegistrationOpen && !isFull)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="Register" method="post" class="d-grid">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary btn-lg">Register for Event</button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary btn-lg w-100">Login to Register</a>
                    }
                }
                else
                {
                    <div class="alert alert-secondary mb-0">Registration is not currently available for this event.</div>
                }

                <a asp-action="Index" class="btn btn-outline-primary w-100 mt-3">Back to Events</a>
            </div>
        </aside>
    </div>
</div>
