@model EventListViewModel
@{
    ViewData["Title"] = "Events";
}

<section class="page-hero">
    <div>
        <p class="page-kicker">Community programme</p>
        <h1 class="mb-2">Upcoming Events</h1>
        <p class="page-subtitle mb-0">Discover and register for local community events happening near you.</p>
    </div>
    <span class="badge badge-blue">Showing @Model.Events.Count event(s)</span>
</section>

<form asp-action="Index" method="get" class="card filter-card mb-4">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label asp-for="Filter.SearchTerm" class="form-label">Search Term</label>
                <input asp-for="Filter.SearchTerm" name="SearchTerm" class="form-control" placeholder="Search events" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label asp-for="Filter.Date" class="form-label"></label>
                <input asp-for="Filter.Date" name="Date" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label asp-for="Filter.VenueId" class="form-label"></label>
                <select asp-for="Filter.VenueId" name="VenueId" class="form-select">
                    <option value="">All venues</option>
                    @foreach (var venue in Model.Venues)
                    {
                        <option value="@venue.Id">@venue.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label asp-for="Filter.ActivityId" class="form-label"></label>
                <select asp-for="Filter.ActivityId" name="ActivityId" class="form-select">
                    <option value="">All activities</option>
                    @foreach (var activity in Model.Activities)
                    {
                        <option value="@activity.Id">@activity.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label asp-for="Filter.ActivityType" class="form-label"></label>
                <select asp-for="Filter.ActivityType" name="ActivityType" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select">
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-6">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">Refine by keyword, date, venue, activity, or type.</span>
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0">Clear Filters</a>
    </div>
</form>

@if (Model.Events.Any())
{
    <div class="row g-4">
        @foreach (var eventItem in Model.Events)
        {
            var capacityRemaining = eventItem.CapacityRemaining;
            var isFull = capacityRemaining.HasValue && capacityRemaining <= 0;
            var isAlmostFull = capacityRemaining.HasValue && capacityRemaining > 0 && capacityRemaining <= 5;
            var statusClass = isFull ? "badge-gray" : isAlmostFull ? "badge-orange" : "badge-green";
            var statusText = isFull ? "Full" : isAlmostFull ? "Almost Full" : "Open";
            var capacityLabel = capacityRemaining.HasValue ? $"{Math.Max(capacityRemaining.Value, 0)} spaces left" : "Open capacity";
            var activityText = string.Join(" ", eventItem.ActivityNames).ToLowerInvariant();
            var visualClass = activityText.Contains("art") || activityText.Contains("movie") || activityText.Contains("family")
                ? "event-visual-purple"
                : activityText.Contains("clean") || activityText.Contains("tree") || activityText.Contains("health") || activityText.Contains("outdoor")
                    ? "event-visual-green"
                    : "event-visual-blue";

            <div class="col-xl-4 col-md-6">
                <article class="card event-card h-100">
                    <div class="event-visual @visualClass">
                        <span class="status-badge @statusClass">@statusText</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex gap-3 mb-3">
                            <div class="date-pill">
                                <span>@eventItem.EventDate.ToString("MMM")</span>
                                <strong>@eventItem.EventDate.Day</strong>
                            </div>
                            <div class="min-w-0">
                                <h2 class="h5 mb-1">@eventItem.Title</h2>
                                <p class="text-muted small mb-1">@string.Join(", ", eventItem.VenueNames)</p>
                                <p class="text-muted small mb-0">@eventItem.StartTime.ToString(@"hh\:mm") - @eventItem.EndTime.ToString(@"hh\:mm")</p>
                            </div>
                        </div>
                        <p class="event-description mb-3">@(eventItem.Description.Length > 140 ? eventItem.Description[..140] + "..." : eventItem.Description)</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var activity in eventItem.ActivityNames)
                            {
                                var badgeClass = activity.Contains("Volunteer", StringComparison.OrdinalIgnoreCase) ? "badge-orange" :
                                    activity.Contains("Family", StringComparison.OrdinalIgnoreCase) || activity.Contains("Entertainment", StringComparison.OrdinalIgnoreCase) ? "badge-purple" :
                                    activity.Contains("Health", StringComparison.OrdinalIgnoreCase) || activity.Contains("Environment", StringComparison.OrdinalIgnoreCase) ? "badge-green" :
                                    "badge-blue";
                                <span class="activity-badge @badgeClass">@activity</span>
                            }
                        </div>
                        <div class="registration-line">
                            <span>@eventItem.ConfirmedRegistrationCount confirmed</span>
                            <span>@capacityLabel</span>
                        </div>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2 p-4">
                        <a asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-primary">View Details</a>
                        @if (eventItem.IsRegistrationOpen && !isFull)
                        {
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="Register" method="post" class="d-inline">
                                    <input type="hidden" name="eventId" value="@eventItem.Id" />
                                    <button type="submit" class="btn btn-outline-primary">Register</button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Events", new { id = eventItem.Id })" class="btn btn-outline-primary">Login to Register</a>
                            }
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <span class="feature-icon mb-3">0</span>
        <h2 class="h4">No matching events found</h2>
        <p class="text-muted mb-3">Try clearing the filters or choosing a different date, venue, or activity.</p>
        <a asp-action="Index" class="btn btn-primary">Show all upcoming events</a>
    </div>
}
