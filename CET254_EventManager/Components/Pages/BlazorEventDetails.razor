@page "/events/{Id:int}"
@page "/blazor/events/{Id:int}"
@inject IEventService EventService
@inject IRegistrationService RegistrationService
@inject IParticipantService ParticipantService
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Event Details</PageTitle>

@if (_isLoading)
{
    <div class="alert alert-info" role="status">
        Loading event details...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_eventItem is not null)
{
    var isFull = GetCapacityRemaining(_eventItem).HasValue && GetCapacityRemaining(_eventItem) <= 0;
    var statusText = _eventItem.EventDate.Date < DateTime.Today ? "Registration Closed" : isFull ? "Full" : "Registration Open";
    var statusClass = _eventItem.EventDate.Date < DateTime.Today || isFull ? "badge-gray" : "badge-green";

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success" role="status">
            @_successMessage
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_registrationErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_registrationErrorMessage
        </div>
    }

    <section class="page-hero event-detail-hero">
        <div class="d-flex gap-3 align-items-start">
            <div class="date-pill date-pill-lg">
                <span>@_eventItem.EventDate.ToString("MMM")</span>
                <strong>@_eventItem.EventDate.Day</strong>
            </div>
            <div>
                <p class="page-kicker">Event details</p>
                <h1 class="mb-2">@_eventItem.Title</h1>
                <p class="page-subtitle mb-0">@_eventItem.EventDate.ToString("D") | @FormatTimeShort(_eventItem.StartTime) - @FormatTimeShort(_eventItem.EndTime)</p>
            </div>
        </div>
        <span class="status-badge @statusClass">@statusText</span>
    </section>

    <div class="row g-4">
        <div class="col-lg-8">
            <article class="card event-details-card h-100">
                <div class="event-visual event-visual-blue event-detail-visual"></div>
                <div class="card-body p-4 p-lg-5">
                    <h2 class="h4 mb-3">About this event</h2>
                    <p class="lead text-muted mb-4">@_eventItem.Description</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="detail-mini-card">
                                <div class="text-muted small">Date</div>
                                <strong>@_eventItem.EventDate.ToString("D")</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-mini-card">
                                <div class="text-muted small">Time</div>
                                <strong>@FormatTimeShort(_eventItem.StartTime) - @FormatTimeShort(_eventItem.EndTime)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h2 class="h5 mb-3">Venues</h2>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var venue in GetVenues(_eventItem))
                            {
                                <span class="venue-chip">@venue.Name</span>
                            }
                        </div>
                    </div>

                    <div>
                        <h2 class="h5 mb-3">Activities</h2>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var activity in GetActivities(_eventItem))
                            {
                                <span class="activity-badge badge-purple">@activity.Name</span>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-lg-4">
            <aside class="card action-panel sticky-lg-top">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Registration</h2>
                    <div class="registration-meter mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Confirmed</span>
                            <strong>@GetConfirmedRegistrationCount(_eventItem)</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Capacity remaining</span>
                            <strong>@GetCapacityRemainingText(_eventItem)</strong>
                        </div>
                    </div>

                    @if (_eventItem.EventDate.Date >= DateTime.Today && !isFull)
                    {
                        @if (!_isAuthenticated)
                        {
                            <a class="btn btn-primary btn-lg w-100" href="@GetLoginUrl()">Login to Register</a>
                        }
                        else
                        {
                            <div class="d-grid">
                                <button type="button" class="btn btn-primary btn-lg" disabled="@_isRegistering" @onclick="RegisterForEventAsync">
                                    @(_isRegistering ? "Registering..." : "Register for Event")
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary mb-0">Registration is not currently available for this event.</div>
                    }

                    <a href="/events" class="btn btn-outline-primary w-100 mt-3">Back to Events</a>
                    <a href="/Events/Details/@Id" class="btn btn-link w-100 mt-2">MVC fallback</a>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? _eventItem;
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isRegistering;
    private string? _errorMessage;
    private string? _registrationErrorMessage;
    private string? _successMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _registrationErrorMessage = null;
        _successMessage = null;

        try
        {
            await LoadAuthenticationStateAsync();
            await LoadEventDetailsAsync();
        }
        catch
        {
            _eventItem = null;
            _errorMessage = "Unable to load this event. It may no longer exist.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAuthenticationStateAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
    }

    private async Task LoadEventDetailsAsync()
    {
        _eventItem = await EventService.GetEventDetailsAsync(Id);
    }

    private async Task RegisterForEventAsync()
    {
        _registrationErrorMessage = null;
        _successMessage = null;
        _isRegistering = true;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authenticationState.User);

            if (user is null)
            {
                _isAuthenticated = false;
                _registrationErrorMessage = "Please log in before registering for this event.";
                return;
            }

            var participant = await GetOrCreateParticipantAsync(user);
            await RegistrationService.RegisterAsync(Id, participant.Id);
            await LoadEventDetailsAsync();
            _successMessage = "Registration submitted successfully.";
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _registrationErrorMessage = ex.Message;
        }
        catch
        {
            _registrationErrorMessage = "Unable to complete registration right now.";
        }
        finally
        {
            _isRegistering = false;
        }
    }

    private async Task<Participant> GetOrCreateParticipantAsync(Microsoft.AspNetCore.Identity.IdentityUser user)
    {
        var participant = await ParticipantService.GetParticipantByApplicationUserIdAsync(user.Id);

        if (participant is not null)
        {
            return participant;
        }

        var email = user.Email ?? user.UserName ?? "user@eventmanager.local";
        var fullName = email.Contains('@') ? email.Split('@')[0] : email;
        var newParticipant = new Participant(fullName, email, string.Empty, user.Id);

        return await ParticipantService.CreateParticipantAsync(newParticipant);
    }

    private string GetLoginUrl()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        return $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private static string FormatTime(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("h:mm tt");
    }

    private static string FormatTimeShort(TimeSpan time)
    {
        return time.ToString(@"hh\:mm");
    }

    private static List<Venue> GetVenues(Event eventItem)
    {
        return eventItem.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue)
            .DistinctBy(venue => venue.Id)
            .ToList();
    }

    private static List<Models.Activity> GetActivities(Event eventItem)
    {
        return eventItem.EventActivities
            .Where(eventActivity => eventActivity.Activity is not null)
            .Select(eventActivity => eventActivity.Activity)
            .DistinctBy(activity => activity.Id)
            .ToList();
    }

    private static int GetConfirmedRegistrationCount(Event eventItem)
    {
        return eventItem.Registrations.Count(registration => registration.Status == RegistrationStatus.Confirmed);
    }

    private static string GetCapacityRemainingText(Event eventItem)
    {
        return GetCapacityRemaining(eventItem)?.ToString() ?? "Not limited";
    }

    private static int? GetCapacityRemaining(Event eventItem)
    {
        var venues = GetVenues(eventItem);
        return venues.Count == 0 ? null : venues.Min(venue => venue.Capacity) - GetConfirmedRegistrationCount(eventItem);
    }
}
