@page "/events"
@inject IEventService EventService
@inject IVenueService VenueService
@inject IActivityService ActivityService

<PageTitle>Events</PageTitle>

<section class="page-hero">
    <div>
        <p class="page-kicker">Community programme</p>
        <h1 class="mb-2">Upcoming Events</h1>
        <p class="page-subtitle mb-0">Discover and register for local community events happening near you.</p>
    </div>
    <span class="badge badge-blue">Showing @_events.Count event(s)</span>
</section>

@if (_isLoading)
{
    <div class="alert alert-info" role="status">
        Loading upcoming events...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}
else if (_events.Count == 0)
{
    <div class="alert alert-secondary" role="status">
        No upcoming events are currently available.
    </div>
}
else
{
    <div class="card filter-card mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label for="searchTerm" class="form-label">Search Term</label>
                    <input id="searchTerm" class="form-control" placeholder="Search events" @bind="_filter.SearchTerm" @bind:event="oninput" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="eventDate" class="form-label">Event Date</label>
                    <input id="eventDate" type="date" class="form-control" value="@FormatDateInput(_filter.Date)" @onchange="SetFilterDate" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="venueId" class="form-label">Venue</label>
                    <select id="venueId" class="form-select" value="@(_filter.VenueId?.ToString() ?? string.Empty)" @onchange="SetFilterVenue">
                        <option value="">All venues</option>
                        @foreach (var venue in _venues)
                        {
                            <option value="@venue.Id">@venue.Name</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="activityId" class="form-label">Activity</label>
                    <select id="activityId" class="form-select" value="@(_filter.ActivityId?.ToString() ?? string.Empty)" @onchange="SetFilterActivity">
                        <option value="">All activities</option>
                        @foreach (var activity in _activities)
                        {
                            <option value="@activity.Id">@activity.Name</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label for="activityType" class="form-label">Activity Type</label>
                    <select id="activityType" class="form-select" @bind="_filter.ActivityType">
                        <option value="">All types</option>
                        @foreach (var activityType in Enum.GetValues<ActivityType>())
                        {
                            <option value="@activityType">@activityType</option>
                        }
                    </select>
                </div>

                <div class="col-lg-1 col-md-6">
                    <button type="button" class="btn btn-primary w-100" @onclick="LoadEventsAsync">Filter</button>
                </div>
            </div>
        </div>

        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-muted small">Refine by keyword, date, venue, activity, or type.</span>
            <button type="button" class="btn btn-link text-decoration-none p-0" @onclick="ClearFiltersAsync">Clear Filters</button>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var eventItem in _events)
        {
            var capacityRemaining = GetCapacityRemaining(eventItem);
            var isFull = capacityRemaining.HasValue && capacityRemaining <= 0;
            var isCompleted = IsEventCompleted(eventItem);
            var capacityLabel = capacityRemaining.HasValue ? $"{Math.Max(capacityRemaining.Value, 0)} spaces left" : "Open capacity";
            var visualClass = GetVisualClass(eventItem);

            <div class="col-xl-4 col-md-6">
                <article class="card h-100 event-card">
                    <div class="event-visual @visualClass">
                        <div class="event-card-status-stack">
                            <span class="event-status-badge @GetEventStatusBadgeClass(eventItem)">
                                @GetEventStatusText(eventItem)
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex gap-3 mb-3">
                            <div class="date-pill">
                                <span>@eventItem.EventDate.ToString("MMM")</span>
                                <strong>@eventItem.EventDate.Day</strong>
                            </div>

                            <div class="min-w-0">
                                <h2 class="h5 mb-1">@eventItem.Title</h2>
                                <p class="text-muted small mb-1">@GetVenueSummary(eventItem)</p>
                                <p class="text-muted small mb-0">@FormatTimeShort(eventItem.StartTime) - @FormatTimeShort(eventItem.EndTime)</p>
                            </div>
                        </div>

                        <p class="event-description mb-3">@GetShortDescription(eventItem.Description)</p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var activity in GetActivityNames(eventItem))
                            {
                                <span class="activity-badge @GetActivityBadgeClass(activity)">@activity</span>
                            }
                        </div>

                        <div class="registration-line">
                            <span>@GetConfirmedRegistrationCount(eventItem) confirmed</span>
                            <span>@capacityLabel</span>
                        </div>
                    </div>

                    <div class="card-footer d-flex flex-wrap gap-2 p-4">
                        <a class="btn btn-primary" href="/events/@eventItem.Id">View Details</a>

                        @if (!isFull && !isCompleted)
                        {
                            <a class="btn btn-outline-primary" href="/events/@eventItem.Id">Register</a>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}

@code {
    private readonly EventFilterViewModel _filter = new();
    private List<Event> _events = new();
    private List<Venue> _venues = new();
    private List<Models.Activity> _activities = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _venues = await VenueService.GetAllVenuesAsync();
            _activities = await ActivityService.GetAllActivitiesAsync();
            await LoadEventsAsync();
        }
        catch
        {
            _errorMessage = "Unable to load upcoming events right now.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEventsAsync()
    {
        _events = await EventService.GetFilteredUpcomingEventsAsync(_filter);

        _events = _events
            .OrderBy(eventItem => IsEventCompleted(eventItem))
            .ThenByDescending(eventItem => eventItem.Id)
            .ToList();
    }

    private async Task ClearFiltersAsync()
    {
        _filter.SearchTerm = null;
        _filter.Date = null;
        _filter.VenueId = null;
        _filter.ActivityId = null;
        _filter.ActivityType = null;
        await LoadEventsAsync();
    }

    private void SetFilterDate(ChangeEventArgs args)
    {
        _filter.Date = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
    }

    private void SetFilterVenue(ChangeEventArgs args)
    {
        _filter.VenueId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
    }

    private void SetFilterActivity(ChangeEventArgs args)
    {
        _filter.ActivityId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
    }

    private static string FormatTimeShort(TimeSpan time)
    {
        return time.ToString(@"hh\:mm");
    }

    private static string FormatDateInput(DateTime? date)
    {
        return date?.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private static string GetVenueSummary(Event eventItem)
    {
        var venues = eventItem.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue.Name)
            .Distinct()
            .ToList();

        return venues.Count == 0 ? "Venue to be confirmed" : string.Join(", ", venues);
    }

    private static List<string> GetActivityNames(Event eventItem)
    {
        return eventItem.EventActivities
            .Where(eventActivity => eventActivity.Activity is not null)
            .Select(eventActivity => eventActivity.Activity.Name)
            .Distinct()
            .ToList();
    }

    private static int GetConfirmedRegistrationCount(Event eventItem)
    {
        return eventItem.Registrations.Count(registration => registration.Status == RegistrationStatus.Confirmed);
    }

    private static int? GetCapacityRemaining(Event eventItem)
    {
        var capacities = eventItem.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue.Capacity)
            .ToList();

        return capacities.Count == 0 ? null : capacities.Min() - GetConfirmedRegistrationCount(eventItem);
    }

    private static string GetShortDescription(string description)
    {
        return description.Length > 140 ? description[..140] + "..." : description;
    }

    private string GetEventStatusText(Event eventItem)
    {
        if (IsEventCompleted(eventItem))
        {
            return "Completed";
        }

        if (IsLatestFutureEvent(eventItem))
        {
            return "New";
        }

        return "Open";
    }

    private string GetEventStatusBadgeClass(Event eventItem)
    {
        if (IsEventCompleted(eventItem))
        {
            return "event-status-completed";
        }

        if (IsLatestFutureEvent(eventItem))
        {
            return "event-status-new";
        }

        return "event-status-open";
    }

    private bool IsLatestFutureEvent(Event eventItem)
    {
        var latestFutureEventId = _events
            .Where(item => !IsEventCompleted(item))
            .Select(item => item.Id)
            .DefaultIfEmpty(0)
            .Max();

        return eventItem.Id == latestFutureEventId;
    }

    private static bool IsEventCompleted(Event eventItem)
    {
        var eventEndDateTime = eventItem.EventDate.Date.Add(eventItem.EndTime);
        return eventEndDateTime < DateTime.Now;
    }

    private static string GetVisualClass(Event eventItem)
    {
        var activityText = string.Join(" ", GetActivityNames(eventItem)).ToLowerInvariant();

        if (activityText.Contains("art") || activityText.Contains("movie") || activityText.Contains("family"))
        {
            return "event-visual-purple";
        }

        if (activityText.Contains("clean") || activityText.Contains("tree") || activityText.Contains("health") || activityText.Contains("outdoor"))
        {
            return "event-visual-green";
        }

        return "event-visual-blue";
    }

    private static string GetActivityBadgeClass(string activity)
    {
        return activity.Contains("Volunteer", StringComparison.OrdinalIgnoreCase) ? "badge-orange" :
            activity.Contains("Family", StringComparison.OrdinalIgnoreCase) || activity.Contains("Entertainment", StringComparison.OrdinalIgnoreCase) ? "badge-purple" :
            activity.Contains("Health", StringComparison.OrdinalIgnoreCase) || activity.Contains("Environment", StringComparison.OrdinalIgnoreCase) ? "badge-green" :
            "badge-blue";
    }
}