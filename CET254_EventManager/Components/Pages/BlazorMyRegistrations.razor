@page "/my-registrations"
@page "/blazor/my-registrations"
@inject IRegistrationService RegistrationService
@inject IParticipantService ParticipantService
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Blazor My Registrations</PageTitle>

<section class="page-hero">
    <div>
        <p class="page-kicker">Participant area</p>
        <h1 class="mb-2">My Registrations</h1>
        <p class="page-subtitle mb-0">Track your event registrations, statuses, and upcoming participation.</p>
    </div>
    <a class="btn btn-primary" href="/events">Browse Events</a>
</section>

@if (_isLoading)
{
    <div class="alert alert-info" role="status">
        Loading your registrations...
    </div>
}
else if (!_isAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        Please <a href="@GetLoginUrl()" class="alert-link">log in</a> to view your registrations.
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success" role="status">
            @_successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    @if (_participant is null)
    {
        <div class="empty-state">
            <h2 class="h4">No participant profile found</h2>
            <p class="text-muted mb-3">Your account is not linked to a participant profile yet.</p>
            <a class="btn btn-primary" href="/events">Browse upcoming events</a>
        </div>
    }
    else if (_registrations.Count == 0)
    {
        <div class="empty-state">
            <h2 class="h4">No registrations yet</h2>
            <p class="text-muted mb-3">Browse upcoming community events and register for one that interests you.</p>
            <a class="btn btn-primary" href="/events">Browse upcoming events</a>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="dashboard-stat-card">
                    <span class="stat-icon">T</span>
                    <div><div class="text-muted small">Total Registrations</div><strong>@_registrations.Count</strong></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-stat-card">
                    <span class="stat-icon">U</span>
                    <div><div class="text-muted small">Upcoming Events</div><strong>@_registrations.Count(registration => registration.Status != RegistrationStatus.Cancelled)</strong></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dashboard-stat-card">
                    <span class="stat-icon">C</span>
                    <div><div class="text-muted small">Confirmed</div><strong>@_registrations.Count(registration => registration.Status == RegistrationStatus.Confirmed)</strong></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="d-grid gap-3">
                    @foreach (var registration in _registrations)
                    {
                        <article class="registration-card">
                            <div class="registration-thumb">
                                <span>@registration.RegistrationDate.ToString("MMM")</span>
                                <strong>@registration.RegistrationDate.Day</strong>
                            </div>
                            <div class="registration-content">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h2 class="h5 mb-1">@GetEventTitle(registration)</h2>
                                        <p class="text-muted small mb-0">Registered @registration.RegistrationDate.ToString("g")</p>
                                    </div>
                                    <span class="status-badge @GetStatusBadgeClass(registration.Status)">@registration.Status</span>
                                </div>
                                <p class="text-muted mb-3">Open the event details page to review the latest date, time, venue, and activity information.</p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="activity-badge badge-blue">Community</span>
                                    <span class="activity-badge badge-purple">Event</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="/events/@registration.EventId">View Details</a>
                                @if (CanCancel(registration))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@IsCancelling(registration)"
                                            @onclick="() => CancelRegistrationAsync(registration.Id)">
                                        @(IsCancelling(registration) ? "Cancelling..." : "Cancel")
                                    </button>
                                }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="status-guide p-4 mb-4">
                    <h2 class="h5 mb-3">Registration Status Guide</h2>
                    <div class="mb-3">
                        <span class="badge badge-green mb-1">Confirmed</span>
                        <p class="text-muted small mb-0">Your registration is confirmed.</p>
                    </div>
                    <div class="mb-3">
                        <span class="badge badge-orange mb-1">Pending</span>
                        <p class="text-muted small mb-0">Your registration is awaiting approval.</p>
                    </div>
                    <div>
                        <span class="badge badge-gray mb-1">Cancelled</span>
                        <p class="text-muted small mb-0">Your registration has been cancelled.</p>
                    </div>
                </aside>
                <aside class="status-guide p-4">
                    <h2 class="h5 mb-2">Need help?</h2>
                    <p class="text-muted mb-0">Contact an administrator if you need support with your registration.</p>
                </aside>
            </div>
        </div>
    }
}

@code {
    private Participant? _participant;
    private List<Registration> _registrations = new();
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private int? _cancellingRegistrationId;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegistrationsAsync();
    }

    private async Task LoadRegistrationsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;

            if (!_isAuthenticated)
            {
                _participant = null;
                _registrations.Clear();
                return;
            }

            var user = await UserManager.GetUserAsync(authenticationState.User);
            if (user is null)
            {
                _isAuthenticated = false;
                _participant = null;
                _registrations.Clear();
                return;
            }

            _participant = await ParticipantService.GetParticipantByApplicationUserIdAsync(user.Id);
            _registrations = _participant is null
                ? new List<Registration>()
                : await RegistrationService.GetParticipantRegistrationsAsync(_participant.Id);
        }
        catch
        {
            _participant = null;
            _registrations.Clear();
            _errorMessage = "Unable to load your registrations right now.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CancelRegistrationAsync(int registrationId)
    {
        if (_participant is null)
        {
            _errorMessage = "No participant profile is linked to your account.";
            return;
        }

        _errorMessage = null;
        _successMessage = null;
        _cancellingRegistrationId = registrationId;

        try
        {
            await RegistrationService.CancelRegistrationAsync(registrationId, _participant.Id);
            _successMessage = "Registration cancelled.";
            _registrations = await RegistrationService.GetParticipantRegistrationsAsync(_participant.Id);
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to cancel this registration right now.";
        }
        finally
        {
            _cancellingRegistrationId = null;
        }
    }

    private string GetLoginUrl()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        return $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private static bool CanCancel(Registration registration)
    {
        return registration.Status != RegistrationStatus.Cancelled;
    }

    private bool IsCancelling(Registration registration)
    {
        return _cancellingRegistrationId == registration.Id;
    }

    private static string GetEventTitle(Registration registration)
    {
        return registration.Event?.Title ?? "Event details unavailable";
    }

    private static string FormatEventDate(Registration registration)
    {
        return registration.Event is null
            ? "Date unavailable"
            : registration.Event.EventDate.ToString("dddd, dd MMM yyyy");
    }

    private static string FormatEventTime(Registration registration)
    {
        return registration.Event is null
            ? "Time unavailable"
            : $"{FormatTime(registration.Event.StartTime)} - {FormatTime(registration.Event.EndTime)}";
    }

    private static string FormatTime(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("h:mm tt");
    }

    private static string GetStatusBadgeClass(RegistrationStatus status)
    {
        return status switch
        {
            RegistrationStatus.Pending => "badge-orange",
            RegistrationStatus.Confirmed => "badge-green",
            RegistrationStatus.Cancelled => "badge-gray",
            _ => "badge-blue"
        };
    }
}
