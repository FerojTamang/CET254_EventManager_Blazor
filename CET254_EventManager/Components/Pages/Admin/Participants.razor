@page "/admin/participants"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using CET254_EventManager.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject IParticipantService ParticipantService
@inject IRegistrationService RegistrationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Admin Participants</PageTitle>

<div class="admin-app-shell">
    <AdminSidebar />

    <main class="admin-app-main">
        <div class="admin-topbar">
            <div>
                <span class="admin-section-kicker">Admin</span>
                <h1>Participants</h1>
            </div>

            <input class="admin-search-box"
                   placeholder="Search participants, email, phone..."
                   aria-label="Search admin participants" />

            <div class="admin-profile-box">
                <span class="admin-profile-avatar">
                    @SvgIcon("user")
                </span>
                <div>
                    <strong>Administrator</strong>
                    <small>Admin area</small>
                </div>
            </div>
        </div>

        <div class="admin-dashboard-content admin-management-page">
            <section class="admin-management-hero">
                <div>
                    <span class="admin-management-icon">
                        @SvgIcon("users")
                    </span>
                    <p class="admin-management-kicker">Admin management</p>
                    <h2>Participants</h2>
                    <p>Create, edit, review, and maintain participant profiles linked to event registrations.</p>
                </div>

                <div class="admin-management-hero-actions">
                    <button type="button" class="btn btn-light" @onclick="ShowCreateForm">
                        <span class="btn-symbol">@SvgIcon("user")</span>
                        Create Participant
                    </button>
                    <a class="btn btn-outline-light" href="/admin">
                        Back to Dashboard
                    </a>
                </div>
            </section>

            @if (_isLoading)
            {
                <div class="alert alert-info" role="status">
                    Loading participants...
                </div>
            }
            else if (!_isAuthenticated)
            {
                <div class="alert alert-warning" role="alert">
                    Please <a href="@GetLoginUrl()" class="alert-link">log in</a> with an admin account to manage participants.
                </div>
            }
            else if (!_isAdmin)
            {
                <div class="alert alert-danger" role="alert">
                    You do not have permission to manage participants.
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <div class="alert alert-success" role="status">
                        @_successMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_errorMessage
                    </div>
                }

                <section class="admin-management-stats">
                    <article class="admin-management-stat">
                        <span>@SvgIcon("users")</span>
                        <div>
                            <strong>@_participants.Count</strong>
                            <small>Total participants</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("registration")</span>
                        <div>
                            <strong>@GetTotalRegistrationCount()</strong>
                            <small>Total registrations</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("linked")</span>
                        <div>
                            <strong>@GetLinkedParticipantCount()</strong>
                            <small>Linked users</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("email")</span>
                        <div>
                            <strong>@GetParticipantsWithEmailCount()</strong>
                            <small>Email records</small>
                        </div>
                    </article>
                </section>

                @if (_mode == PageMode.Create)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Create</span>
                                <h2>Create Participant</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <EditForm Model="_formModel" OnValidSubmit="CreateParticipantAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="admin-form-grid">
                                @ParticipantFormFields()
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @(_isSaving ? "Creating..." : "Create Participant")
                                </button>
                                <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    </section>
                }
                else if (_mode == PageMode.Edit)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Edit</span>
                                <h2>Edit Participant</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <EditForm Model="_formModel" OnValidSubmit="UpdateParticipantAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="admin-form-grid">
                                @ParticipantFormFields()

                                <div class="mb-0">
                                    <label class="form-label">Identity User</label>
                                    <input value="@(_formModel.ApplicationUserId ?? "Not linked")" class="form-control" disabled />
                                    <div class="form-text">Identity user accounts are not managed from participant pages.</div>
                                </div>
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @(_isSaving ? "Saving..." : "Save Changes")
                                </button>
                                <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    </section>
                }
                else if (_mode == PageMode.Details && _selectedParticipant is not null)
                {
                    <section class="admin-panel-card admin-management-detail-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Details</span>
                                <h2>@_selectedParticipant.FullName</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <div class="admin-detail-summary">
                            <div>
                                <span>@SvgIcon("user")</span>
                                <strong>@_selectedParticipant.FullName</strong>
                                <small>Participant name</small>
                            </div>
                            <div>
                                <span>@SvgIcon("email")</span>
                                <strong>@_selectedParticipant.Email</strong>
                                <small>Email address</small>
                            </div>
                            <div>
                                <span>@SvgIcon("phone")</span>
                                <strong>@GetPhoneText(_selectedParticipant)</strong>
                                <small>Phone number</small>
                            </div>
                            <div>
                                <span>@SvgIcon("registration")</span>
                                <strong>@_selectedRegistrations.Count</strong>
                                <small>Registrations</small>
                            </div>
                        </div>

                        <dl class="row detail-list">
                            <dt class="col-sm-3">Identity User</dt>
                            <dd class="col-sm-9">@(_selectedParticipant.ApplicationUserId ?? "Not linked")</dd>
                        </dl>

                        @if (_selectedRegistrations.Count == 0)
                        {
                            <div class="admin-empty-state">
                                <strong>No registrations found.</strong>
                                <span>This participant has no registrations yet.</span>
                            </div>
                        }
                        else
                        {
                            <div class="admin-table-modern">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th scope="col">Event</th>
                                            <th scope="col">Event Date</th>
                                            <th scope="col">Registered</th>
                                            <th scope="col">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var registration in _selectedRegistrations)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="admin-table-title-cell">
                                                        <span>@SvgIcon("event")</span>
                                                        <div>
                                                            <strong>@GetEventTitle(registration)</strong>
                                                            <small>Community event</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@FormatEventDate(registration)</td>
                                                <td>@registration.RegistrationDate.ToString("dd MMM yyyy, h:mm tt")</td>
                                                <td>
                                                    <span class="status-badge @GetStatusBadgeClass(registration.Status)">
                                                        @registration.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="admin-form-actions">
                            <button type="button" class="btn btn-warning" @onclick="() => ShowEditForm(_selectedParticipant.Id)">Edit</button>
                            <button type="button" class="btn btn-danger" @onclick="() => ShowDeleteConfirmationAsync(_selectedParticipant.Id)">Delete</button>
                        </div>
                    </section>
                }
                else if (_mode == PageMode.Delete && _selectedParticipant is not null)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Delete</span>
                                <h2>Delete Participant</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        @if (_selectedRegistrations.Count > 0)
                        {
                            <div class="alert alert-warning">
                                This participant has @_selectedRegistrations.Count event registration(s). Deletion will be blocked by the existing service rule.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                Are you sure you want to delete this participant profile?
                            </div>
                        }

                        <div class="admin-delete-preview">
                            <span>@SvgIcon("user")</span>
                            <div>
                                <strong>@_selectedParticipant.FullName</strong>
                                <small>@_selectedParticipant.Email</small>
                                <p>Phone: @GetPhoneText(_selectedParticipant)</p>
                            </div>
                        </div>

                        <div class="admin-form-actions">
                            <button type="button" class="btn btn-danger" disabled="@_isSaving" @onclick="DeleteParticipantAsync">
                                @(_isSaving ? "Deleting..." : "Delete Participant")
                            </button>
                            <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                Cancel
                            </button>
                        </div>
                    </section>
                }

                @if (_participants.Count == 0)
                {
                    <div class="admin-empty-state">
                        <strong>No participants yet</strong>
                        <span>Create the first participant profile to get started.</span>
                        <button type="button" class="btn btn-primary mt-3" @onclick="ShowCreateForm">Create Participant</button>
                    </div>
                }
                else
                {
                    <section class="admin-panel-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">People</span>
                                <h2>Participant List</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ShowCreateForm">
                                Create Participant
                            </button>
                        </div>

                        <div class="admin-table-modern">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Participant</th>
                                        <th scope="col">Email</th>
                                        <th scope="col">Phone</th>
                                        <th scope="col">Registrations</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var participant in _participants)
                                    {
                                        <tr>
                                            <td>
                                                <div class="admin-registration-person">
                                                    <span class="admin-registration-avatar">
                                                        @SvgIcon("user")
                                                    </span>
                                                    <div>
                                                        <strong>@participant.FullName</strong>
                                                        <small>Participant profile</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@participant.Email</td>
                                            <td>@GetPhoneText(participant)</td>
                                            <td>
                                                <span class="badge badge-blue">@GetRegistrationCount(participant.Id)</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="admin-action-buttons">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowDetailsAsync(participant.Id)">Details</button>
                                                    <button type="button" class="btn btn-sm btn-warning" @onclick="() => ShowEditForm(participant.Id)">Edit</button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmationAsync(participant.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </div>
    </main>
</div>

@code {
    private enum PageMode
    {
        List,
        Create,
        Edit,
        Details,
        Delete
    }

    private List<Participant> _participants = new();
    private Dictionary<int, int> _registrationCounts = new();
    private ParticipantViewModel _formModel = new();
    private Participant? _selectedParticipant;
    private List<Registration> _selectedRegistrations = new();
    private PageMode _mode = PageMode.List;
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private RenderFragment ParticipantFormFields() => @<div>
        <div class="mb-3">
            <label for="participantFullName" class="form-label">Full name</label>
            <InputText id="participantFullName" class="form-control" @bind-Value="_formModel.FullName" />
            <ValidationMessage For="@(() => _formModel.FullName)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="participantEmail" class="form-label">Email</label>
            <InputText id="participantEmail" class="form-control" @bind-Value="_formModel.Email" />
            <ValidationMessage For="@(() => _formModel.Email)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="participantPhoneNumber" class="form-label">Phone number</label>
            <InputText id="participantPhoneNumber" class="form-control" @bind-Value="_formModel.PhoneNumber" />
            <ValidationMessage For="@(() => _formModel.PhoneNumber)" class="text-danger" />
        </div>
    </div>;

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
            _isAdmin = authenticationState.User.IsInRole("Admin");

            if (!_isAuthenticated || !_isAdmin)
            {
                _participants.Clear();
                return;
            }

            await LoadParticipantsAsync();
        }
        catch
        {
            _participants.Clear();
            _errorMessage = "Unable to load participants right now.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadParticipantsAsync()
    {
        _participants = await ParticipantService.GetAllParticipantsAsync();
        _registrationCounts = new Dictionary<int, int>();

        foreach (var participant in _participants)
        {
            var registrations = await RegistrationService.GetParticipantRegistrationsAsync(participant.Id);
            _registrationCounts[participant.Id] = registrations.Count;
        }
    }

    private void ShowCreateForm()
    {
        _errorMessage = null;
        _successMessage = null;
        _selectedParticipant = null;
        _selectedRegistrations.Clear();
        _formModel = new ParticipantViewModel();
        _mode = PageMode.Create;
    }

    private void ShowEditForm(int participantId)
    {
        _errorMessage = null;
        _successMessage = null;
        var participant = _participants.FirstOrDefault(item => item.Id == participantId);

        if (participant is null)
        {
            _errorMessage = "Unable to find this participant.";
            return;
        }

        _selectedParticipant = participant;
        _selectedRegistrations.Clear();
        _formModel = MapParticipant(participant);
        _mode = PageMode.Edit;
    }

    private async Task ShowDetailsAsync(int participantId)
    {
        await SelectParticipantAsync(participantId, PageMode.Details);
    }

    private async Task ShowDeleteConfirmationAsync(int participantId)
    {
        await SelectParticipantAsync(participantId, PageMode.Delete);
    }

    private async Task SelectParticipantAsync(int participantId, PageMode mode)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            _selectedParticipant = await ParticipantService.GetParticipantByIdAsync(participantId);
            _selectedRegistrations = await RegistrationService.GetParticipantRegistrationsAsync(participantId);
            _mode = mode;
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to load this participant right now.";
        }
    }

    private async Task CreateParticipantAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            var participant = new Participant(_formModel.FullName, _formModel.Email, _formModel.PhoneNumber);
            await ParticipantService.CreateParticipantAsync(participant);
            _successMessage = "Participant created successfully.";
            await LoadParticipantsAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to create this participant right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UpdateParticipantAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            var participant = await ParticipantService.GetParticipantByIdAsync(_formModel.Id);
            participant.UpdateDetails(_formModel.FullName, _formModel.Email, _formModel.PhoneNumber, _formModel.ApplicationUserId);
            await ParticipantService.UpdateParticipantAsync(participant);
            _successMessage = "Participant updated successfully.";
            await LoadParticipantsAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to update this participant right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteParticipantAsync()
    {
        if (_selectedParticipant is null)
        {
            _errorMessage = "Unable to find this participant.";
            return;
        }

        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            await ParticipantService.DeleteParticipantAsync(_selectedParticipant.Id);
            _successMessage = "Participant deleted successfully.";
            await LoadParticipantsAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to delete this participant right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ClearSelection()
    {
        _mode = PageMode.List;
        _selectedParticipant = null;
        _selectedRegistrations.Clear();
        _formModel = new ParticipantViewModel();
    }

    private string GetLoginUrl()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        return $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private int GetRegistrationCount(int participantId)
    {
        return _registrationCounts.TryGetValue(participantId, out var count) ? count : 0;
    }

    private int GetTotalRegistrationCount()
    {
        return _registrationCounts.Values.Sum();
    }

    private int GetLinkedParticipantCount()
    {
        return _participants.Count(participant => !string.IsNullOrWhiteSpace(participant.ApplicationUserId));
    }

    private int GetParticipantsWithEmailCount()
    {
        return _participants.Count(participant => !string.IsNullOrWhiteSpace(participant.Email));
    }

    private static ParticipantViewModel MapParticipant(Participant participant)
    {
        return new ParticipantViewModel
        {
            Id = participant.Id,
            FullName = participant.FullName,
            Email = participant.Email,
            PhoneNumber = participant.PhoneNumber,
            ApplicationUserId = participant.ApplicationUserId
        };
    }

    private static string GetPhoneText(Participant participant)
    {
        return string.IsNullOrWhiteSpace(participant.PhoneNumber) ? "Not provided" : participant.PhoneNumber;
    }

    private static string GetEventTitle(Registration registration)
    {
        return registration.Event?.Title ?? "Event unavailable";
    }

    private static string FormatEventDate(Registration registration)
    {
        return registration.Event is null
            ? "Date unavailable"
            : registration.Event.EventDate.ToString("dddd, dd MMM yyyy");
    }

    private static string GetStatusBadgeClass(RegistrationStatus status)
    {
        return status switch
        {
            RegistrationStatus.Pending => "badge-orange",
            RegistrationStatus.Confirmed => "badge-green",
            RegistrationStatus.Cancelled => "badge-gray",
            _ => "badge-blue"
        };
    }

    private RenderFragment SvgIcon(string name) => name switch
    {
        "event" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 2v3M17 2v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 6h3v3H8v-3Zm5 0h3v3h-3v-3Z" />
        </svg>,

        "registration" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 3h8l1 2h2a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2l1-2Zm1 4h6M8 11h8M8 15h8M8 19h5" />
        </svg>,

        "users" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4 0-7 2-7 4.5V20h14v-2.5C16 15 13 13 9 13Zm8.5-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 2c-.8 0-1.5.1-2.2.4 1.6 1 2.7 2.4 2.7 4.1V20h4v-2.2c0-2.5-2-4.8-4.5-4.8Z" />
        </svg>,

        "user" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.4-8 5.3V22h16v-2.7C20 16.4 16.4 14 12 14Z" />
        </svg>,

        "linked" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 12a4 4 0 0 1 4-4h3V6h-3a6 6 0 0 0 0 12h3v-2h-3a4 4 0 0 1-4-4Zm3 1h6v-2h-6v2Zm1-5H9V6h3a6 6 0 0 1 0 12H9v-2h3a4 4 0 0 0 0-8Z" />
        </svg>,

        "email" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm8 8 8-5V7l-8 5-8-5v1l8 5Z" />
        </svg>,

        "phone" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.4.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1.1l-2.2 2.2Z" />
        </svg>,

        _ => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" />
        </svg>
    };
}