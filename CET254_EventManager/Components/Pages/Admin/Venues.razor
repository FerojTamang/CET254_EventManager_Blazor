@page "/admin/venues"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using CET254_EventManager.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject IVenueService VenueService
@inject IEventService EventService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Admin Venues</PageTitle>

<div class="admin-app-shell">
    <AdminSidebar />

    <main class="admin-app-main">
        <div class="admin-topbar">
            <div>
                <span class="admin-section-kicker">Admin</span>
                <h1>Venues</h1>
            </div>

            <input class="admin-search-box"
                   placeholder="Search venues, address, capacity..."
                   aria-label="Search admin venues" />

            <div class="admin-profile-box">
                <span class="admin-profile-avatar">
                    @SvgIcon("user")
                </span>
                <div>
                    <strong>Administrator</strong>
                    <small>Admin area</small>
                </div>
            </div>
        </div>

        <div class="admin-dashboard-content admin-management-page">
            <section class="admin-management-hero">
                <div>
                    <span class="admin-management-icon">
                        @SvgIcon("venue")
                    </span>
                    <p class="admin-management-kicker">Admin management</p>
                    <h2>Venues</h2>
                    <p>Maintain event locations, addresses, seating capacity, and venue assignments.</p>
                </div>

                <div class="admin-management-hero-actions">
                    <button type="button" class="btn btn-light" @onclick="ShowCreateForm">
                        <span class="btn-symbol">@SvgIcon("venue")</span>
                        Create Venue
                    </button>
                    <a class="btn btn-outline-light" href="/admin">
                        Back to Dashboard
                    </a>
                </div>
            </section>

            @if (_isLoading)
            {
                <div class="alert alert-info" role="status">
                    Loading venues...
                </div>
            }
            else if (!_isAuthenticated)
            {
                <div class="alert alert-warning" role="alert">
                    Please <a href="@GetLoginUrl()" class="alert-link">log in</a> with an admin account to manage venues.
                </div>
            }
            else if (!_isAdmin)
            {
                <div class="alert alert-danger" role="alert">
                    You do not have permission to manage venues.
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <div class="alert alert-success" role="status">
                        @_successMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_errorMessage
                    </div>
                }

                <section class="admin-management-stats">
                    <article class="admin-management-stat">
                        <span>@SvgIcon("venue")</span>
                        <div>
                            <strong>@_venues.Count</strong>
                            <small>Total venues</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("capacity")</span>
                        <div>
                            <strong>@GetTotalCapacity()</strong>
                            <small>Total capacity</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("event")</span>
                        <div>
                            <strong>@GetTotalAssignedEvents()</strong>
                            <small>Assigned events</small>
                        </div>
                    </article>

                    <article class="admin-management-stat">
                        <span>@SvgIcon("available")</span>
                        <div>
                            <strong>@GetUnassignedVenueCount()</strong>
                            <small>Unassigned venues</small>
                        </div>
                    </article>
                </section>

                @if (_mode == PageMode.Create)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Create</span>
                                <h2>Create Venue</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <EditForm Model="_formModel" OnValidSubmit="CreateVenueAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="admin-form-grid">
                                @VenueFormFields()
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @(_isSaving ? "Creating..." : "Create Venue")
                                </button>
                                <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    </section>
                }
                else if (_mode == PageMode.Edit)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Edit</span>
                                <h2>Edit Venue</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <EditForm Model="_formModel" OnValidSubmit="UpdateVenueAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="admin-form-grid">
                                @VenueFormFields()
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @(_isSaving ? "Saving..." : "Save Changes")
                                </button>
                                <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    </section>
                }
                else if (_mode == PageMode.Details && _selectedVenue is not null)
                {
                    <section class="admin-panel-card admin-management-detail-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Details</span>
                                <h2>@_selectedVenue.Name</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        <div class="admin-detail-summary">
                            <div>
                                <span>@SvgIcon("venue")</span>
                                <strong>@_selectedVenue.Name</strong>
                                <small>Venue name</small>
                            </div>
                            <div>
                                <span>@SvgIcon("location")</span>
                                <strong>@_selectedVenue.Address</strong>
                                <small>Address</small>
                            </div>
                            <div>
                                <span>@SvgIcon("capacity")</span>
                                <strong>@_selectedVenue.Capacity</strong>
                                <small>Capacity</small>
                            </div>
                            <div>
                                <span>@SvgIcon("event")</span>
                                <strong>@GetAssignedEventCount(_selectedVenue.Id)</strong>
                                <small>Assigned events</small>
                            </div>
                        </div>

                        @AssignedEventsTable(_selectedVenue.Id)

                        <div class="admin-form-actions">
                            <button type="button" class="btn btn-warning" @onclick="() => ShowEditForm(_selectedVenue.Id)">Edit</button>
                            <button type="button" class="btn btn-danger" @onclick="() => ShowDeleteConfirmation(_selectedVenue.Id)">Delete</button>
                        </div>
                    </section>
                }
                else if (_mode == PageMode.Delete && _selectedVenue is not null)
                {
                    <section class="admin-panel-card admin-management-form-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Delete</span>
                                <h2>Delete Venue</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearSelection">Close</button>
                        </div>

                        @if (GetAssignedEventCount(_selectedVenue.Id) > 0)
                        {
                            <div class="alert alert-warning">
                                This venue is assigned to @GetAssignedEventCount(_selectedVenue.Id) event(s). Deletion will be blocked by the existing service rule.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                Are you sure you want to delete this venue?
                            </div>
                        }

                        <div class="admin-delete-preview">
                            <span>@SvgIcon("venue")</span>
                            <div>
                                <strong>@_selectedVenue.Name</strong>
                                <small>@_selectedVenue.Address</small>
                                <p>Capacity: @_selectedVenue.Capacity</p>
                            </div>
                        </div>

                        <div class="admin-form-actions">
                            <button type="button" class="btn btn-danger" disabled="@_isSaving" @onclick="DeleteVenueAsync">
                                @(_isSaving ? "Deleting..." : "Delete Venue")
                            </button>
                            <button type="button" class="btn btn-outline-primary" @onclick="ClearSelection">
                                Cancel
                            </button>
                        </div>
                    </section>
                }

                @if (_venues.Count == 0)
                {
                    <div class="admin-empty-state">
                        <strong>No venues yet</strong>
                        <span>Create the first venue to make it available for events.</span>
                        <button type="button" class="btn btn-primary mt-3" @onclick="ShowCreateForm">Create Venue</button>
                    </div>
                }
                else
                {
                    <section class="admin-panel-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Locations</span>
                                <h2>Venue List</h2>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ShowCreateForm">
                                Create Venue
                            </button>
                        </div>

                        <div class="admin-table-modern">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Venue</th>
                                        <th scope="col">Address</th>
                                        <th scope="col">Capacity</th>
                                        <th scope="col">Assigned Events</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var venue in _venues)
                                    {
                                        <tr>
                                            <td>
                                                <div class="admin-table-title-cell">
                                                    <span>@SvgIcon("venue")</span>
                                                    <div>
                                                        <strong>@venue.Name</strong>
                                                        <small>Event location</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@venue.Address</td>
                                            <td>
                                                <span class="badge badge-blue">@venue.Capacity seats</span>
                                            </td>
                                            <td>
                                                <span class="badge badge-purple">@GetAssignedEventCount(venue.Id)</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="admin-action-buttons">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowDetails(venue.Id)">Details</button>
                                                    <button type="button" class="btn btn-sm btn-warning" @onclick="() => ShowEditForm(venue.Id)">Edit</button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmation(venue.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </div>
    </main>
</div>

@code {
    private enum PageMode
    {
        List,
        Create,
        Edit,
        Details,
        Delete
    }

    private List<Venue> _venues = new();
    private List<Event> _events = new();
    private Dictionary<int, List<Event>> _assignedEventsByVenueId = new();
    private VenueViewModel _formModel = new();
    private Venue? _selectedVenue;
    private PageMode _mode = PageMode.List;
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private RenderFragment VenueFormFields() => @<div>
        <div class="mb-3">
            <label for="venueName" class="form-label">Name</label>
            <InputText id="venueName" class="form-control" @bind-Value="_formModel.Name" />
            <ValidationMessage For="@(() => _formModel.Name)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="venueAddress" class="form-label">Address</label>
            <InputText id="venueAddress" class="form-control" @bind-Value="_formModel.Address" />
            <ValidationMessage For="@(() => _formModel.Address)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="venueCapacity" class="form-label">Capacity</label>
            <InputNumber id="venueCapacity" class="form-control" @bind-Value="_formModel.Capacity" />
            <ValidationMessage For="@(() => _formModel.Capacity)" class="text-danger" />
        </div>
    </div>;

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
            _isAdmin = authenticationState.User.IsInRole("Admin");

            if (!_isAuthenticated || !_isAdmin)
            {
                _venues.Clear();
                return;
            }

            await LoadVenuesAsync();
        }
        catch
        {
            _venues.Clear();
            _errorMessage = "Unable to load venues right now.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadVenuesAsync()
    {
        _venues = await VenueService.GetAllVenuesAsync();
        await LoadEventAssignmentsAsync();
    }

    private async Task LoadEventAssignmentsAsync()
    {
        var eventSummaries = await EventService.GetUpcomingEventsAsync();
        _events = new List<Event>();

        foreach (var eventSummary in eventSummaries)
        {
            _events.Add(await EventService.GetEventDetailsAsync(eventSummary.Id));
        }

        _assignedEventsByVenueId = _events
            .SelectMany(eventItem => eventItem.EventVenues
                .Select(eventVenue => new { eventVenue.VenueId, Event = eventItem }))
            .GroupBy(item => item.VenueId)
            .ToDictionary(group => group.Key, group => group.Select(item => item.Event).ToList());
    }

    private void ShowCreateForm()
    {
        _errorMessage = null;
        _successMessage = null;
        _selectedVenue = null;
        _formModel = new VenueViewModel();
        _mode = PageMode.Create;
    }

    private void ShowEditForm(int venueId)
    {
        _errorMessage = null;
        _successMessage = null;
        var venue = _venues.FirstOrDefault(item => item.Id == venueId);

        if (venue is null)
        {
            _errorMessage = "Unable to find this venue.";
            return;
        }

        _selectedVenue = venue;
        _formModel = MapVenue(venue);
        _mode = PageMode.Edit;
    }

    private void ShowDetails(int venueId)
    {
        SelectVenue(venueId, PageMode.Details);
    }

    private void ShowDeleteConfirmation(int venueId)
    {
        SelectVenue(venueId, PageMode.Delete);
    }

    private void SelectVenue(int venueId, PageMode mode)
    {
        _errorMessage = null;
        _successMessage = null;
        _selectedVenue = _venues.FirstOrDefault(item => item.Id == venueId);

        if (_selectedVenue is null)
        {
            _errorMessage = "Unable to find this venue.";
            return;
        }

        _mode = mode;
    }

    private async Task CreateVenueAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            await VenueService.CreateVenueAsync(new Venue(_formModel.Name, _formModel.Address, _formModel.Capacity));
            _successMessage = "Venue created successfully.";
            await LoadVenuesAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to create this venue right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UpdateVenueAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            var venue = await VenueService.GetVenueByIdAsync(_formModel.Id);
            venue.UpdateDetails(_formModel.Name, _formModel.Address, _formModel.Capacity);
            await VenueService.UpdateVenueAsync(venue);
            _successMessage = "Venue updated successfully.";
            await LoadVenuesAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to update this venue right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteVenueAsync()
    {
        if (_selectedVenue is null)
        {
            _errorMessage = "Unable to find this venue.";
            return;
        }

        _errorMessage = null;
        _successMessage = null;
        _isSaving = true;

        try
        {
            await VenueService.DeleteVenueAsync(_selectedVenue.Id);
            _successMessage = "Venue deleted successfully.";
            await LoadVenuesAsync();
            ClearSelection();
        }
        catch (CET254_EventManager.Exceptions.AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Unable to delete this venue right now.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ClearSelection()
    {
        _mode = PageMode.List;
        _selectedVenue = null;
        _formModel = new VenueViewModel();
    }

    private string GetLoginUrl()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        return $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private int GetAssignedEventCount(int venueId)
    {
        return _assignedEventsByVenueId.TryGetValue(venueId, out var events) ? events.Count : 0;
    }

    private int GetTotalCapacity()
    {
        return _venues.Sum(venue => venue.Capacity);
    }

    private int GetTotalAssignedEvents()
    {
        return _assignedEventsByVenueId.Values.Sum(events => events.Count);
    }

    private int GetUnassignedVenueCount()
    {
        return _venues.Count(venue => GetAssignedEventCount(venue.Id) == 0);
    }

    private RenderFragment AssignedEventsTable(int venueId) => builder =>
    {
        var assignedEvents = _assignedEventsByVenueId.TryGetValue(venueId, out var events)
            ? events.OrderBy(eventItem => eventItem.EventDate).ToList()
            : new List<Event>();

        if (assignedEvents.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "admin-empty-state");
            builder.OpenElement(2, "strong");
            builder.AddContent(3, "No assigned events.");
            builder.CloseElement();
            builder.OpenElement(4, "span");
            builder.AddContent(5, "This venue is not assigned to any upcoming events.");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "class", "admin-table-modern");
        builder.OpenElement(8, "table");
        builder.AddAttribute(9, "class", "table align-middle");
        builder.AddMarkupContent(10, "<thead><tr><th scope=\"col\">Event</th><th scope=\"col\">Date</th><th scope=\"col\">Time</th></tr></thead>");
        builder.OpenElement(11, "tbody");

        var sequence = 12;
        foreach (var eventItem in assignedEvents)
        {
            builder.OpenElement(sequence++, "tr");

            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "class", "fw-semibold");
            builder.AddContent(sequence++, eventItem.Title);
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, eventItem.EventDate.ToString("dd MMM yyyy"));
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, $"{FormatTime(eventItem.StartTime)} - {FormatTime(eventItem.EndTime)}");
            builder.CloseElement();

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private static VenueViewModel MapVenue(Venue venue)
    {
        return new VenueViewModel
        {
            Id = venue.Id,
            Name = venue.Name,
            Address = venue.Address,
            Capacity = venue.Capacity
        };
    }

    private static string FormatTime(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("h:mm tt");
    }

    private RenderFragment SvgIcon(string name) => name switch
    {
        "venue" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" />
        </svg>,

        "location" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z" />
        </svg>,

        "capacity" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM7 13c-3.3 0-5 1.7-5 3.5V19h10v-2.5C12 14.7 10.3 13 7 13Zm10 0c-1.2 0-2.2.2-3 .7 1.1.8 1.8 1.8 1.8 2.8V19H22v-2.5c0-1.8-1.7-3.5-5-3.5Z" />
        </svg>,

        "event" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 2v3M17 2v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 6h3v3H8v-3Zm5 0h3v3h-3v-3Z" />
        </svg>,

        "available" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.2 16.6 4.9 12.3l1.7-1.7 2.6 2.6 8.2-8.2 1.7 1.7-9.9 9.9Z" />
        </svg>,

        "user" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.4-8 5.3V22h16v-2.7C20 16.4 16.4 14 12 14Z" />
        </svg>,

        _ => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" />
        </svg>
    };
}