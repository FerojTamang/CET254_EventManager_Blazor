@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using CET254_EventManager.Components.Shared
@inject IAdminDashboardService AdminDashboardService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Admin Dashboard</PageTitle>

<div class="admin-app-shell">
    <AdminSidebar />

    <main class="admin-app-main">
        @if (_isLoading)
        {
            <div class="alert alert-info" role="status">
                Loading admin dashboard...
            </div>
        }
        else if (!_isAuthenticated)
        {
            <div class="alert alert-warning" role="alert">
                Please <a href="@GetLoginUrl()" class="alert-link">log in</a> with an admin account to view this page.
            </div>
        }
        else if (!_isAdmin)
        {
            <div class="alert alert-danger" role="alert">
                You do not have permission to view the admin dashboard.
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @_errorMessage
            </div>
        }
        else if (_dashboard is not null)
        {
            <div class="admin-topbar">
                <div>
                    <span class="admin-section-kicker">Admin</span>
                    <h1>Dashboard</h1>
                </div>

                <input class="admin-search-box"
                       placeholder="Search events, participants, venues..."
                       aria-label="Search admin records" />

                <div class="admin-profile-box">
                    <span class="admin-profile-avatar">
                        @SvgIcon("user")
                    </span>
                    <div>
                        <strong>Administrator</strong>
                        <small>Admin area</small>
                    </div>
                </div>
            </div>

            <div class="admin-dashboard-content">
                <section class="admin-dashboard-hero">
                    <div class="admin-hero-copy">
                        <h2>Welcome back, Administrator!</h2>
                        <p>
                            Control centre for managing community events, participants, venues,
                            activities and registrations.
                        </p>

                        <div class="admin-hero-actions">
                            <a class="btn btn-light" href="/admin/events">
                                <span class="btn-symbol">@SvgIcon("event")</span>
                                Create New Event
                            </a>

                            <a class="btn btn-outline-light" href="/events">
                                <span class="btn-symbol">@SvgIcon("users")</span>
                                View All Events
                            </a>
                        </div>
                    </div>

                    <div class="admin-hero-visual" aria-hidden="true">
                        <div class="admin-schedule-card admin-schedule-card-wide">
                            <div class="admin-schedule-calendar">
                                <div class="admin-schedule-top">
                                    <button type="button" class="admin-calendar-arrow" tabindex="-1">‹</button>
                                    <strong>@DateTime.Today.ToString("MMM yyyy")</strong>
                                    <button type="button" class="admin-calendar-arrow" tabindex="-1">›</button>
                                </div>

                                <div class="admin-schedule-weekdays">
                                    @foreach (var dayLabel in WeekdayLabels)
                                    {
                                        <span>@dayLabel</span>
                                    }
                                </div>

                                <div class="admin-schedule-grid">
                                    @foreach (var day in CalendarDays)
                                    {
                                        <span class="@(day == DateTime.Today.Day ? "is-active" : null)">@day</span>
                                    }
                                </div>
                            </div>

                            <div class="admin-schedule-list">
                                <h3>Dashboard Summary</h3>

                                <div class="admin-schedule-item">
                                    <span class="schedule-dot schedule-dot-blue"></span>
                                    <strong>@_dashboard.TotalEvents events</strong>
                                    <small>Programme</small>
                                </div>

                                <div class="admin-schedule-item">
                                    <span class="schedule-dot schedule-dot-green"></span>
                                    <strong>@_dashboard.PendingRegistrations pending</strong>
                                    <small>Awaiting review</small>
                                </div>

                                <div class="admin-schedule-item">
                                    <span class="schedule-dot schedule-dot-orange"></span>
                                    <strong>@TotalRegistrations registrations</strong>
                                    <small>All statuses</small>
                                </div>

                                <a href="/admin/registrations">View full registration list →</a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="admin-stat-grid" aria-label="Dashboard statistics">
                    @StatCard("event", _dashboard.TotalEvents, "Total Events", "Events currently held in the programme.", "/admin/events", "Manage events", "accent-blue")
                    @StatCard("users", _dashboard.TotalParticipants, "Participants", "Participant profiles available to manage.", "/admin/participants", "Manage participants", "accent-purple")
                    @StatCard("venue", _dashboard.TotalVenues, "Venues", "Venues available for event scheduling.", "/admin/venues", "Manage venues", "accent-green")
                    @StatCard("activity", _dashboard.TotalActivities, "Activities", "Activities assigned across community events.", "/admin/activities", "Manage activities", "accent-orange")
                    @StatCard("registration", TotalRegistrations, "Registrations", "All registration records across statuses.", "/admin/registrations", "View registrations", "accent-indigo")
                </section>

                <section class="admin-dashboard-grid">
                    <article class="admin-panel-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Registration status</span>
                                <h2>Registration Status Overview</h2>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" href="/admin/registrations">Manage</a>
                        </div>

                        @if (TotalRegistrations == 0)
                        {
                            <div class="admin-empty-state">
                                <strong>No registrations found.</strong>
                                <span>No pending registrations at the moment.</span>
                            </div>
                        }
                        else
                        {
                            <div class="admin-overview-list">
                                @ProgressRow("Pending", _dashboard.PendingRegistrations, "status-pending")
                                @ProgressRow("Confirmed", _dashboard.ConfirmedRegistrations, "status-confirmed")
                                @ProgressRow("Cancelled", _dashboard.CancelledRegistrations, "status-cancelled")
                                @ProgressRow("Total Registrations", TotalRegistrations, "status-total")
                            </div>
                        }
                    </article>

                    <article class="admin-panel-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Shortcuts</span>
                                <h2>Quick Actions</h2>
                            </div>
                        </div>

                        <div class="admin-action-grid">
                            @ActionTile("event", "Manage Events", "Create, update, delete, and assign venues or activities.", "/admin/events")
                            @ActionTile("users", "Manage Participants", "Review and maintain participant records.", "/admin/participants")
                            @ActionTile("venue", "Manage Venues", "Maintain locations and venue capacity.", "/admin/venues")
                            @ActionTile("activity", "Manage Activities", "Organize workshops, talks, games, and other activities.", "/admin/activities")
                            @ActionTile("registration", "Manage Registrations", "Confirm or cancel participant registrations.", "/admin/registrations")
                        </div>
                    </article>

                    <article class="admin-panel-card admin-upcoming-card">
                        <div class="admin-panel-header">
                            <div>
                                <span class="admin-section-kicker">Programme</span>
                                <h2>Upcoming Events</h2>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" href="/events">View events</a>
                        </div>

                        <div class="admin-upcoming-list">
                            <div class="admin-upcoming-item">
                                <span class="admin-upcoming-date">
                                    <strong>@DateTime.Today.ToString("MMM")</strong>
                                    <small>@DateTime.Today.Day</small>
                                </span>

                                <div>
                                    <strong>Live event programme</strong>
                                    <small>Open the events page to view current upcoming events.</small>
                                </div>

                                <a href="/events">View</a>
                            </div>

                            <div class="admin-upcoming-item">
                                <span class="admin-upcoming-date admin-upcoming-date-soft">
                                    <strong>@DateTime.Today.AddDays(7).ToString("MMM")</strong>
                                    <small>@DateTime.Today.AddDays(7).Day</small>
                                </span>

                                <div>
                                    <strong>Admin event management</strong>
                                    <small>Create, update, and assign venues or activities.</small>
                                </div>

                                <a href="/admin/events">Manage</a>
                            </div>
                        </div>
                    </article>
                </section>

                <section class="admin-panel-card">
                    <div class="admin-panel-header">
                        <div>
                            <span class="admin-section-kicker">Latest activity</span>
                            <h2>Recent Registrations</h2>
                        </div>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/registrations">View all registrations</a>
                    </div>

                    @if (_dashboard.RecentRegistrations.Any())
                    {
                        <div class="admin-recent-table">
                            <div class="admin-registration-row admin-registration-heading">
                                <span>Participant</span>
                                <span>Event</span>
                                <span>Date / Time</span>
                                <span>Status</span>
                            </div>

                            @foreach (var registration in _dashboard.RecentRegistrations)
                            {
                                <article class="admin-registration-row">
                                    <div class="admin-registration-person">
                                        <span class="admin-registration-avatar">
                                            @SvgIcon("user")
                                        </span>
                                        <div>
                                            <strong>@registration.ParticipantName</strong>
                                            <small>Participant</small>
                                        </div>
                                    </div>

                                    <div>
                                        <span>@registration.EventTitle</span>
                                        <small>Event</small>
                                    </div>

                                    <div>
                                        <span>@registration.RegistrationDate.ToString("dd MMM yyyy, h:mm tt")</span>
                                    </div>

                                    <div>
                                        <span class="admin-status-badge @GetAdminStatusClass(registration.Status)">
                                            @registration.Status
                                        </span>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="admin-empty-state">
                            <strong>No registrations found.</strong>
                            <span>New participant registrations will appear here.</span>
                        </div>
                    }
                </section>
            </div>
        }
    </main>
</div>

@code {
    private AdminDashboardViewModel? _dashboard;
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isAdmin;
    private string? _errorMessage;

    private static readonly string[] WeekdayLabels =
    {
        "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"
    };

    private int TotalRegistrations =>
        (_dashboard?.PendingRegistrations ?? 0)
        + (_dashboard?.ConfirmedRegistrations ?? 0)
        + (_dashboard?.CancelledRegistrations ?? 0);

    private static IEnumerable<int> CalendarDays =>
        Enumerable.Range(1, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            _isAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
            _isAdmin = authenticationState.User.IsInRole("Admin");

            if (!_isAuthenticated || !_isAdmin)
            {
                return;
            }

            _dashboard = await AdminDashboardService.GetDashboardAsync();
        }
        catch
        {
            _errorMessage = "Unable to load the admin dashboard right now.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private RenderFragment StatCard(
        string iconName,
        int value,
        string label,
        string description,
        string href,
        string linkText,
        string accentClass) => @<article class="admin-stat-card">
            <span class="admin-stat-icon @accentClass">@SvgIcon(iconName)</span>

            <div class="admin-stat-copy">
                <strong>@value</strong>
                <span>@label</span>
                <small>@description</small>
            </div>

            <a class="admin-stat-link" href="@href">@linkText</a>
        </article>;

    private RenderFragment ProgressRow(
        string label,
        int count,
        string statusClass) => @<div class="admin-progress-row">
            <div class="admin-progress-label">
                <span class="admin-status-badge @statusClass">@label</span>
                <strong>
                    @count
                    <small>@GetRegistrationPercentage(count)%</small>
                </strong>
            </div>

            <div class="admin-progress-track"
                 role="progressbar"
                 aria-label="@($"{label} registrations")"
                 aria-valuenow="@GetRegistrationPercentage(count)"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <span class="admin-progress-fill @statusClass"
                      style="width: @GetRegistrationPercentage(count)%"></span>
            </div>
        </div>;

    private RenderFragment ActionTile(
        string iconName,
        string title,
        string description,
        string href) => @<a class="admin-action-tile" href="@href">
            <span>@SvgIcon(iconName)</span>
            <strong>@title</strong>
            <small>@description</small>
        </a>;

    private string GetLoginUrl()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        return $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private int GetRegistrationPercentage(int count)
    {
        return TotalRegistrations == 0
            ? 0
            : (int)Math.Round((double)count / TotalRegistrations * 100);
    }

    private static string GetAdminStatusClass(RegistrationStatus status)
    {
        return status switch
        {
            RegistrationStatus.Pending => "status-pending",
            RegistrationStatus.Confirmed => "status-confirmed",
            RegistrationStatus.Cancelled => "status-cancelled",
            _ => "status-cancelled"
        };
    }

    private RenderFragment SvgIcon(string name) => name switch
    {
        "dashboard" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 10.8 12 3l9 7.8v9.7a.5.5 0 0 1-.5.5H15v-6H9v6H3.5a.5.5 0 0 1-.5-.5v-9.7Z" />
        </svg>,

        "event" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 2v3M17 2v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 6h3v3H8v-3Zm5 0h3v3h-3v-3Z" />
        </svg>,

        "registration" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 3h8l1 2h2a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2l1-2Zm1 4h6M8 11h8M8 15h8M8 19h5" />
        </svg>,

        "users" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4 0-7 2-7 4.5V20h14v-2.5C16 15 13 13 9 13Zm8.5-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 2c-.8 0-1.5.1-2.2.4 1.6 1 2.7 2.4 2.7 4.1V20h4v-2.2c0-2.5-2-4.8-4.5-4.8Z" />
        </svg>,

        "user" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.4-8 5.3V22h16v-2.7C20 16.4 16.4 14 12 14Z" />
        </svg>,

        "venue" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" />
        </svg>,

        "activity" => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 4a2 2 0 1 1 4 0 2 2 0 0 1-4 0ZM7 22l2.5-6.2L7 13.5l-2 3.2-2-1.2 3-5 4.2 2.4 1.5-4.2-2.7-.8.7-2.2 5.8 1.8-2.2 6.2 3.2 3.3 3.7-1.3.8 2.2-4.8 1.7-4.2-4.2L9.3 22H7Z" />
        </svg>,

        _ => @<svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" />
        </svg>
    };
}